---
import { Image, getImage } from 'astro:assets'
import Layout from '../../layouts/Layout.astro'
import SpotifyPlayer from '../../components/SpotifyPlayer.jsx'
import CompraProducto from '../../islands/CompraProducto.jsx'
import { cargarCatalogo, recortar, SITIO } from '../../lib/datos.js'

export async function getStaticPaths() {
  const { productos } = await cargarCatalogo()
  return productos.map((producto) => ({ params: { slug: producto.slug }, props: { producto } }))
}

const { producto: p } = Astro.props
const base = Astro.site ?? new URL(SITIO)
const url = new URL(Astro.url.pathname, base).href

const portadaMini = await getImage({ src: p.imagen, width: 180, height: 180, format: 'webp', quality: 70 })

const titulo = recortar(`${p.titulo} - ${p.artista} | VINILO`, 60)
const descripcion = recortar(
  `Compra el vinilo ${p.titulo} de ${p.artista} por $${p.precio}. ${p.stock > 0 ? 'Disponible' : 'Agotado'} en VINILO con envío gratis desde $1800.`,
  160
)

const datosEstructurados = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: p.titulo,
  image: [p.imagen],
  description: descripcion,
  sku: p.id,
  brand: { '@type': 'Brand', name: p.artista },
  ...(p.categoria ? { category: p.categoria.nombre } : {}),
  offers: {
    '@type': 'Offer',
    url,
    priceCurrency: 'MXN',
    price: p.precio.toFixed(2),
    itemCondition: 'https://schema.org/NewCondition',
    availability: p.stock > 0 ? 'https://schema.org/InStock' : 'https://schema.org/OutOfStock',
  },
}
---
<Layout titulo={titulo} descripcion={descripcion} imagen={p.imagen} tipoOg="product" catalogo>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(datosEstructurados)} />
  </Fragment>
  <main class="productContainer">
    <a class="backBtn" href="/">← Volver al catalogo</a>
    <div class="productDetail">
      <div class="productImageContainer">
        <Image
          src={p.imagen}
          alt={`Portada del vinilo ${p.titulo} de ${p.artista}`}
          class="productImage"
          width={600}
          height={600}
          widths={[400, 600, 800]}
          sizes="(max-width: 768px) 100vw, 40vw"
          quality={75}
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
        <SpotifyPlayer
          client:visible
          uri={p.spotify_uri}
          titulo={p.titulo}
          artista={p.artista}
          portada={portadaMini.src}
          etiquetas={[p.categoria?.nombre, 'Vinilo'].filter(Boolean)}
        />
      </div>
      <div class="productInfo">
        <span class="productArtist">{p.artista}</span>
        <h1 class="productTitle">{p.titulo}</h1>
        <p class="productPrecio">${p.precio}</p>
        <p class="productStock">Stock: {p.stock}</p>
        <CompraProducto client:idle id={p.id} stock={p.stock} />
      </div>
    </div>
  </main>
</Layout>
